# ==============================================================================
# Codex CLI Environment Variables Template
# 复制该文件为 ~/.codex/.env 或在 ~/.zshrc 中导出环境变量
# ==============================================================================

# 默认 OpenAI / 标准兼容端点 Key（由 auth.json 自动管理或在此显式指定）
# OPENAI_API_KEY="sk-..."

# 自定义网关服务商（按需配置）
# STRINGAI_API_KEY="sk-..."
# AIGO_API_KEY="sk-..."
# LELEAPI_API_KEY="sk-..."
# CODEXZH_API_KEY="sk-..."

# 多模态与第三方模型支持
# GOOGLE_GENERATIVE_AI_API_KEY="AIzaSy..."
# GROK_API_KEY="xai-..."
