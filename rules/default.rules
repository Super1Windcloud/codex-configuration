# Package managers & build tools
prefix_rule(pattern=["brew"], decision="allow")
prefix_rule(pattern=["./gradlew"], decision="allow")
prefix_rule(pattern=["gradle"], decision="allow")
prefix_rule(pattern=["cargo"], decision="allow")
prefix_rule(pattern=["just"], decision="allow")
prefix_rule(pattern=["npm"], decision="allow")
prefix_rule(pattern=["pnpm"], decision="allow")
prefix_rule(pattern=["yarn"], decision="allow")
prefix_rule(pattern=["bun"], decision="allow")
prefix_rule(pattern=["node"], decision="allow")
prefix_rule(pattern=["rustup"], decision="allow")
prefix_rule(pattern=["rustc"], decision="allow")

# Version control
prefix_rule(pattern=["git"], decision="allow")

# Android & Device tools
prefix_rule(pattern=["adb"], decision="allow")

# Common inspection & tools
prefix_rule(pattern=["find"], decision="allow")
prefix_rule(pattern=["grep"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["curl"], decision="allow")
prefix_rule(pattern=["sqlite3"], decision="allow")
prefix_rule(pattern=["tree"], decision="allow")
prefix_rule(pattern=["diff"], decision="allow")
prefix_rule(pattern=["ps"], decision="allow")
prefix_rule(pattern=["lsof"], decision="allow")

# Containers & virtualization
prefix_rule(pattern=["docker"], decision="allow")
prefix_rule(pattern=["podman"], decision="allow")

# Archives & compression
prefix_rule(pattern=["tar"], decision="allow")
prefix_rule(pattern=["unzip"], decision="allow")
prefix_rule(pattern=["zip"], decision="allow")
